<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <record id="view_winery_sample_list" model="ir.ui.view">
    <field name="name">winery.sample.list</field>
    <field name="model">winery.sample</field>
    <field name="arch" type="xml">
      <list string="Tasting Samples">
        <field name="sequence" widget="handle"/>
        <field name="product_id"
          domain="[('is_winery_product', '=', True), ('winery_estate_id', '=', estate_id)]"/>
        <field name="product_variety_ids" widget="many2many_tags" options="{'color_field': 'tag_color'}"/>
        <field name="year"/>
        <field name="score"/>
        <field name="notes"/>
      </list>
    </field>
  </record>

  <record id="view_winery_sample_form" model="ir.ui.view">
    <field name="name">winery.sample.form</field>
    <field name="model">winery.sample</field>
    <field name="arch" type="xml">
      <form string="Tasting Sample">
        <sheet>
          <group>
            <group>
              <field name="product_id"
                domain="[('is_winery_product', '=', True), ('winery_estate_id', '=', estate_id)]"/>
              <field name="product_variety_ids" widget="many2many_tags" options="{'color_field': 'tag_color'}"/>
              <field name="year"/>
            </group>
            <group>
              <field name="sequence"/>
            </group>
          </group>
          <group name="notes_group" string="Notes">
            <field name="notes"/>
            <field name="score"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_winery_sample_form_wine_service" model="ir.ui.view">
    <field name="name">winery.sample.form.wine.service</field>
    <field name="model">winery.sample</field>
    <field name="inherit_id" ref="winery_crm.view_winery_sample_form"/>
    <field name="arch" type="xml">
      <xpath expr="//group[@name='notes_group']" position="after">
        <group string="Wine Service &amp; Warnings">
          <field name="has_allergen_warning" readonly="1"/>
          <field name="allergen_warning_text"
            invisible="not has_allergen_warning"
            readonly="1"/>

          <field name="has_serving_note" readonly="1"/>
          <field name="serving_note_text"
            invisible="not has_serving_note"
            readonly="1"/>

          <field name="has_organic_cert" readonly="1"/>
          <field name="organic_cert_text"
            invisible="not has_organic_cert"
            readonly="1"/>
        </group>
      </xpath>
    </field>
  </record>

</odoo>
