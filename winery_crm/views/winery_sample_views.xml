<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <record id="view_winery_sample_list" model="ir.ui.view">
    <field name="name">winery.sample.list</field>
    <field name="model">winery.sample</field>
    <field name="arch" type="xml">
      <list editable="bottom">
        <field name="sequence" widget="handle"/>
        <field name="product_id"
          domain="[('is_winery_product', '=', True), ('winery_estate_id', '=', estate_id)]"/>
        <field name="product_variety_ids" widget="many2many_tags" options="{'color_field': 'tag_color'}"/>
        <field name="year"/>
        <field name="score"/>
        <field name="notes"/>
      </list>
    </field>
  </record>

  <record id="view_winery_sample_form" model="ir.ui.view">
    <field name="name">winery.sample.form</field>
    <field name="model">winery.sample</field>
    <field name="arch" type="xml">
      <form string="Tasting Sample">
        <sheet>
          <group>
            <group>
              <field name="product_id"
                domain="[('is_winery_product', '=', True), ('winery_estate_id', '=', estate_id)]"/>
              <field name="product_variety_ids" widget="many2many_tags" options="{'color_field': 'tag_color'}"/>
              <field name="year"/>
            </group>
            <group>
              <field name="sequence"/>
              <field name="score"/>
            </group>
          </group>
          <group string="Notes">
            <field name="notes"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

</odoo>
