<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- Tasting list (list) -->
  <record id="view_winery_tasting_list" model="ir.ui.view">
    <field name="name">winery.tasting.list</field>
    <field name="model">winery.tasting</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="estate_id"/>
        <field name="partner_id"/>
        <field name="date_start"/>
        <field name="date_end"/>
        <field name="state"/>
        <field name="sample_count"/>
      </list>
    </field>
  </record>

  <!-- Tasting form -->
  <record id="view_winery_tasting_form" model="ir.ui.view">
    <field name="name">winery.tasting.form</field>
    <field name="model">winery.tasting</field>
    <field name="arch" type="xml">
      <form string="Winery Tasting">
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="estate_id"/>
              <field name="partner_id"/>
            </group>
            <group>
              <field name="date_start"/>
              <field name="date_end"/>
              <field name="state"/>
              <field name="sample_count" readonly="1"/>
            </group>
          </group>
          <notebook>
            <page string="Attendees">
              <field name="attendees_ids" widget="many2many_tags"/>
            </page>
            <page string="Samples">
              <field name="sample_ids"/>
            </page>
            <page string="Notes">
              <field name="notes"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

</odoo>