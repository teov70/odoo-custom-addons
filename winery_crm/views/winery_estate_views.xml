<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- Estate list (list) -->
  <record id="view_winery_estate_list" model="ir.ui.view">
    <field name="name">winery.estate.list</field>
    <field name="model">winery.estate</field>
    <field name="arch" type="xml">
      <list>
        <field name="name" class="o_ellipsis" width="150"/>
        <field name="region" class="o_ellipsis" width="150"/>
        <field name="city"/>
        <field name="country_id"/>
        <field name="vineyard_area_ha"/>
        <field name="orchard_area_ha"/>
        <field name="tasting_capacity_indoor"/>
        <field name="tasting_capacity_outdoor"/>
        <field name="tasting_capacity_total"/>
        <field name="upcoming_attendees"/>
        <field name="capacity_utilization"/>
      </list>
    </field>
  </record>

  <!-- Estate form -->
  <record id="view_winery_estate_form" model="ir.ui.view">
    <field name="name">winery.estate.form</field>
    <field name="model">winery.estate</field>
    <field name="arch" type="xml">
      <form string="Winery Estate">
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="partner_id"/>
              <field name="region"/>
              <field name="visiting_hours"/>
            </group>
            <group>
              <field name="variety_ids" widget="many2many_tags" options="{'color_field': 'tag_color'}"/>
              <field name="vineyard_area_ha"/>
              <field name="orchard_area_ha"/>
              <field name="tasting_capacity_indoor"/>
              <field name="tasting_capacity_outdoor"/>
              <field name="tasting_capacity_total" readonly="1"/>
              <field name="upcoming_attendees" readonly="1"/>
              <field name="capacity_utilization" readonly="1"/>
            </group>
          </group>
          <group string="Address &amp; Location" colspan="4">
            <group>
              <field name="street"/>
              <field name="street2"/>
              <field name="zip"/>
              <field name="city"/>
              <field name="country_id"/>
            </group>
            <group>
              <field name="latitude"/>
              <field name="longitude"/>
            </group>
          </group>
          <notebook>
            <page string="Description">
              <field name="description" options="{'codeview': true}"/>
            </page>
            <page string="Tastings">
              <field name="tasting_ids">
                <list>
                  <field name="name"/>
                  <field name="date_start"/>
                  <field name="date_end"/>
                  <field name="state"/>
                  <field name="partner_id"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

</odoo>
